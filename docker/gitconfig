# Box Yard's Docker runner image: git's system config (docs/docker.md). No secrets: it only reads the turn's env.
[init]
	defaultBranch = main
[safe]
	directory = *
# GitHub's token is the turn's $GITHUB_TOKEN (the project's own, else Settings › Credentials'), read when git asks.
# This helper comes first and nothing writes a credential store or ~/.git-credentials, so no stored token can answer
# before it (on Upstash boxes a global credential.helper=store won over a project's GITHUB_TOKEN). Only github.com
# gets it. Parser source: githubCredentialHelper(true) in server/gitShare.ts; regression tests enforce parity.
[credential "https://github.com"]
	helper =
	helper = "!f() { test \"$1\" = get || return 0; by_protocol= by_host=; while IFS= read -r by_line; do case \"$by_line\" in '') break ;; protocol=*) test -z \"$by_protocol\" && test \"$by_line\" = protocol=https || return 0; by_protocol=https ;; host=*) test -z \"$by_host\" && test \"$by_line\" = host=github.com || return 0; by_host=github.com ;; path=*|username=*|password=*|wwwauth\\[\\]=*|capability\\[\\]=*) ;; *) return 0 ;; esac; done; test -z \"$by_line\" && test \"$by_protocol:$by_host\" = https:github.com || return 0; by_token=\"${GITHUB_TOKEN:-$GH_TOKEN}\"; test -n \"$by_token\" || return 0; printf '%s\\n' username=x-access-token \"password=$by_token\"; }; f"
